# Copy to .env and fill in. .env is in .gitignore.
#
# IMPORTANT: plain KEY=value only, no leading "export". Both `docker compose`
# (env_file) and `container run --env-file` reject the export form.

# --- Updating another machine ---------------------------------------------
# Used by: make deploy — the machine whose container gets the new binary, and
# the path of the repository checkout there
REMOTE_HOST=
REMOTE_USER=
REMOTE_REPO=

# --- SSH tunnel to the jump host -----------------------------------------
# Only for a host that cannot reach z/OSMF itself. With direct access, leave
# this whole block empty and start the server with `make docker-up-direct` or
# `make container-up-direct`.
#
# The host that can reach the z/OSMF systems. Format: user@host
JUMP_HOST=user@jumphost.example.com

# Private SSH key for JUMP_HOST. On Linux the file must be owned by root and
# mode 600, otherwise OpenSSH refuses it:
#   sudo chown 0:0 secrets/jump_key && sudo chmod 600 secrets/jump_key
JUMP_KEY=./secrets/jump_key

# --- z/OSMF credentials ---------------------------------------------------
# These names must match the ${...} references in your configuration file
# exactly. Example for systems named SYSA and SYSB:
ZOSMF_SYSA_PASSWORD=
ZOSMF_SYSB_PASSWORD=

# Fallback for systems whose configuration carries no password at all.
# Only used when a system has no auth.password set.
ZOSMF_PASSWORD=

# --- MCP server -----------------------------------------------------------
# Bearer token for the HTTP transports. Generate with:
#   make apikey        (openssl rand -base64 32)
# Without it the server refuses to start once an HTTP transport is enabled.
MCP_API_KEY=

# --- Mounts ---------------------------------------------------------------
# Path to your existing configuration on the host — NOT a file this repository
# ships. Defaults to the repo directory.
ZOSMF_CONFIG=./.smpe-zosmf.yaml

# Directory holding the SSH key(s) for the ZOAU tools (not the tunnel — that
# one uses JUMP_KEY). Mounted at /keys when the directory exists.
SSH_KEY_DIR=./secrets

# --- Proxy ----------------------------------------------------------------
# Set by the tunnel setup; the make targets supply it. Set it empty for a host
# with direct access if this file is otherwise shared with a tunnelled one —
# an empty value leaves the proxy off.
# ZOSMF_PROXY=
