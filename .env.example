# Kopieren nach .env und ausfüllen. .env ist in .gitignore.
#
# WICHTIG: Nur KEY=value, kein "export" davor. Sowohl `docker compose`
# (env_file) als auch `container run --env-file` lehnen die export-Form ab.

# --- Deployment ohne Container -------------------------------------------
# Used by: make deploy (macOS remote deployment target)
REMOTE_HOST=
REMOTE_USER=

# --- SSH-Tunnel zum Jump-Host --------------------------------------------
# Der Host, der die z/OSMF-Systeme erreicht. Form: user@host
JUMP_HOST=user@jumphost.example.com

# Privater SSH-Schlüssel für JUMP_HOST. Unter Linux muss die Datei root
# gehören und Modus 600 haben, sonst lehnt OpenSSH sie ab:
#   sudo chown 0:0 secrets/jump_key && sudo chmod 600 secrets/jump_key
JUMP_KEY=./secrets/jump_key

# --- z/OSMF-Zugangsdaten --------------------------------------------------
# Die Namen müssen zu den ${...}-Referenzen in deiner Konfiguration passen.
# Beispiel für Systeme namens SYSA und SYSB:
ZOSMF_SYSA_PASSWORD=
ZOSMF_SYSB_PASSWORD=

# Fallback für Systeme, deren Konfiguration gar kein Passwort enthält.
# Wird nur benutzt, wenn im System kein auth.password gesetzt ist.
ZOSMF_PASSWORD=

# --- MCP-Server -----------------------------------------------------------
# Bearer-Token für die HTTP-Transports. Erzeugen mit:
#   openssl rand -base64 32
# Ohne diesen Wert startet der Server nicht, sobald ein HTTP-Transport läuft.
MCP_API_KEY=

# --- Mounts ---------------------------------------------------------------
# Pfad zu deiner bestehenden Konfiguration auf dem Host — KEINE Datei, die
# dieses Repository mitliefert. Zeigt standardmäßig ins Repo-Verzeichnis.
ZOSMF_CONFIG=./.smpe-zosmf.yaml

# Verzeichnis mit den SSH-Schlüsseln für die ZOAU-Tools (nicht für den
# Tunnel — der nutzt JUMP_KEY).
SSH_KEY_DIR=./secrets
