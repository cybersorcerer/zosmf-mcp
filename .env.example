# Kopieren nach .env und ausfüllen. .env ist in .gitignore.

# Used by: make deploy (macOS remote deployment target)
REMOTE_HOST=
REMOTE_USER=

# Used by: docker-compose.yml (ssh tunnel sidecar + zosmf-mcp container)
JUMP_HOST=user@jumphost.example.com
ZOSMF_PASSWORD=
MCP_API_KEY=

# Path to an existing .smpe-zosmf.yaml on the host — NOT a file this repo ships.
# Point it at your production config wherever it lives; defaults to the repo directory.
ZOSMF_CONFIG=./.smpe-zosmf.yaml

# Directory on the host holding the SSH private key(s) used by the zosmf-mcp
# container and the tunnel sidecar. Defaults to ./secrets in the repo directory.
SSH_KEY_DIR=./secrets

# Path to the SSH private key used by the tunnel sidecar to reach JUMP_HOST.
# Defaults to a file named jump_key inside ./secrets.
JUMP_KEY=./secrets/jump_key
